<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:label="RepTimer"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. 
                 android:screenOrientation="portrait" : Keeps the screen in portrait mode -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />

        <!-- Icônes de la notification persistante (voir
             SessionNotificationService), référencées depuis Dart via
             NotificationIcon(metaDataName: ...) plutôt que par nom de
             ressource dynamique : cette indirection survit correctement
             au resource shrinker (R8), contrairement à une résolution
             par nom en dur. -->
        <meta-data
            android:name="session_notification_icon_play"
            android:resource="@drawable/ic_notification_play" />
        <meta-data
            android:name="session_notification_icon_pause"
            android:resource="@drawable/ic_notification_pause" />

        <!-- Service de premier plan (flutter_foreground_task) affichant la
             notification persistante pendant l'exécution d'une séance (voir
             lib/services/session_notification_service.dart). Ne fait rien
             d'autre que garder le processus actif et afficher/mettre à jour
             cette notification : toute la logique de chronométrage reste
             dans SessionController (isolate principal), jamais dupliquée
             ici. android:stopWithTask="true" : la notification disparaît si
             l'utilisateur retire l'application de la liste des apps
             récentes, plutôt que de laisser une notification orpheline sans
             application à rouvrir derrière.
             "specialUse" est le type de Foreground Service le plus honnête
             ici : l'app ne lit aucun capteur (le type "health" imposerait
             de déclarer ACTIVITY_RECOGNITION/BODY_SENSORS, non utilisés). -->
        <service
            android:name="com.pravera.flutter_foreground_task.service.ForegroundService"
            android:foregroundServiceType="specialUse"
            android:exported="false"
            android:stopWithTask="true">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Affiche le chronomètre ou le compte à rebours d'une séance d'entraînement en cours, pour que l'utilisateur puisse suivre sa progression pendant qu'il utilise une autre application." />
        </service>
    </application>

    <!--User Permission :
        VIBRATE : to allow vibrate the Device-->
    <uses-permission android:name="android.permission.VIBRATE"/>

    <!-- Notification persistante de séance (voir SessionNotificationService) :
         FOREGROUND_SERVICE (obligatoire pour tout Foreground Service),
         FOREGROUND_SERVICE_SPECIAL_USE (obligatoire pour le type déclaré
         ci-dessus sur Android 14+), POST_NOTIFICATIONS (obligatoire sur
         Android 13+ pour afficher n'importe quelle notification), WAKE_LOCK
         (déjà nécessaire à wakelock_plus, également utilisé par
         flutter_foreground_task pour maintenir le CPU actif pendant la
         séance). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <uses-permission android:name="android.permission.WAKE_LOCK"/>

    <!-- Requise par FlutterForegroundTask.requestIgnoreBatteryOptimization(),
         utilisée pour fiabiliser le chronomètre de la notification en
         arrière-plan sur les appareils dont le fabricant applique une
         gestion de batterie plus agressive que le comportement standard
         Android (ex : MIUI). -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"/>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>